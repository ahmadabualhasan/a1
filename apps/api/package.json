{
  "name": "@codek/api",
  "version": "0.1.0",
  "private": true,
  "description": "CODEK modular-monolith API (NestJS 11, REST /api/v1).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "dev": "tsx watch --tsconfig tsconfig.json src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "openapi": "node dist/scripts/export-openapi.js",
    "admin:create": "node dist/scripts/create-admin.js",
    "test:load": "vitest run -c vitest.load.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@codek/config": "workspace:*",
    "@codek/database": "workspace:*",
    "@codek/domain": "workspace:*",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "better-auth": "1.7.6",
    "bullmq": "6.3.10",
    "cookie-parser": "1.4.7",
    "decimal.js": "10.6.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "multer": "2.4.0",
    "nestjs-pino": "5.2.1",
    "nestjs-zod": "5.5.0",
    "nodemailer": "10.0.12",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@codek/eslint-config": "workspace:*",
    "@codek/tsconfig": "workspace:*",
    "@nestjs/testing": "11.2.6",
    "@swc/core": "1.16.12",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  },
  "files": [
    "dist"
  ]
}
