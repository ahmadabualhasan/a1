# ─────────────────────────────────────────────────────────────────────────────
# CODEK environment template. Copy to `.env` for local development.
# NEVER commit real secrets. Staging and production values live in the
# deployment platform's secret manager, never in this repository.
# Every variable is documented in docs/ENVIRONMENT.md.
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=development            # development | test | staging | production
NODE_ENV=development
LOG_LEVEL=info

API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
TRACKING_PUBLIC_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Number of proxies in front of the API that append to X-Forwarded-For (0/false = none, true = 1). See docs/DEPLOYMENT.md.
TRUST_PROXY=false

DATABASE_URL=postgresql://codek:codek_dev_password@localhost:5432/codek_dev?schema=public
# Used only by automated tests (destroyed/reset by the test suite).
TEST_DATABASE_URL=postgresql://codek:codek_dev_password@localhost:5432/codek_test?schema=public
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=codek

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
AUTH_REQUIRE_EMAIL_VERIFICATION=true
SESSION_TTL_SECONDS=604800

# Generate with: openssl rand -hex 32
HASH_PEPPER=replace-with-random-pepper
# Generate with: openssl rand -base64 32  (must decode to exactly 32 bytes)
SECRETS_MASTER_KEY=replace-with-base64-32-byte-key-xxxxxxxxxxxxxxx=
# Only during a master-key rotation: the old key (decrypt fallback). See docs/RECOVERY.md.
SECRETS_MASTER_KEY_PREVIOUS=
SECRETS_BACKEND=local-encrypted

STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=./storage-data
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=10485760
# Upload malware scanning: none | clamav (clamd INSTREAM; uploads fail closed if the scanner is unreachable)
MALWARE_SCANNER=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

EMAIL_DRIVER=log                # log | smtp  (log is forbidden in production)
EMAIL_FROM="CODEK <no-reply@codek.local>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

PAYOUT_PROVIDER=sandbox         # sandbox | paypal  (sandbox is forbidden in production)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

WEBHOOK_TOLERANCE_SECONDS=300
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
OUTBOUND_HOST_ALLOWLIST=api-m.sandbox.paypal.com,api-m.paypal.com,myshopify.com

# Reserved (no error-reporting SDK in this build): must stay empty.
SENTRY_DSN=
METRICS_ENABLED=true
# Required in staging/production when metrics are enabled (min 24 chars). Scrapers send "Authorization: Bearer <token>".
METRICS_TOKEN=

# Web (Next.js) — server-side URL the web app uses to proxy /api/v1 to the API.
API_INTERNAL_URL=http://localhost:4000
