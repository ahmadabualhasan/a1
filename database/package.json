{
  "name": "@codek/database",
  "version": "0.1.0",
  "private": true,
  "description": "CODEK PostgreSQL schema (Prisma), migrations, DB invariants and seed.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:reset": "prisma migrate reset --force",
    "validate": "prisma validate",
    "seed": "tsx src/seed/run.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@codek/domain": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.4.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@codek/eslint-config": "workspace:*",
    "@codek/tsconfig": "workspace:*",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
