// ─────────────────────────────────────────────────────────────────────────────
// CODEK database schema — spec §19 master entity set + field-level addendum.
// Conventions: UUID PKs, snake_case tables/columns, timestamptz (UTC), money as
// BigInt minor units + ISO currency, rates as Decimal, JSONB only for extensible
// configuration. DB-level invariants (ledger balance, immutability, audit hash
// chain, check constraints) live in the SQL migrations (see docs/DATABASE.md).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity & access ─────────────────────────────

enum AccountType {
  business
  creator
  admin
}

enum UserStatus {
  active
  suspended
  deleted
}

/// Primary identity (Better Auth "user" model). Email stored lower-cased and unique.
model User {
  id               String      @id @default(uuid()) @db.Uuid
  email            String      @unique
  emailVerified    Boolean     @default(false) @map("email_verified")
  emailVerifiedAt  DateTime?   @map("email_verified_at") @db.Timestamptz(6)
  name             String      @map("display_name")
  image            String?
  accountType      AccountType @default(creator) @map("account_type")
  status           UserStatus  @default(active)
  twoFactorEnabled Boolean     @default(false) @map("two_factor_enabled")
  lastLoginAt      DateTime?   @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions            Session[]
  accounts            Account[]
  twoFactors          TwoFactor[]
  verificationTokens  VerificationToken[]
  userRoles           UserRole[]
  businessMemberships BusinessMember[]
  ownedBusinesses     Business[]               @relation("BusinessOwner")
  creator             Creator?
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  legalAcceptances    LegalAcceptance[]

  @@map("users")
}

/// DB-backed session (Better Auth "session" model). Raw IPs are not stored (ip_hash only).
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  token      String    @unique
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  ipHash     String?   @map("ip_hash")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Authentication provider/credential (Better Auth "account" model).
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("provider_account_id")
  providerId            String    @map("provider")
  password              String?   @map("password_hash")
  accessToken           String?   @map("access_token_ref")
  refreshToken          String?   @map("refresh_token_ref")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

enum VerificationPurpose {
  email_verification
  password_reset
  mfa_other
}

/// Email verification / recovery tokens (Better Auth "verification" model; `value` holds the opaque token data).
model VerificationToken {
  id         String               @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  userId     String?              @map("user_id") @db.Uuid
  purpose    VerificationPurpose?
  expiresAt  DateTime             @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime?            @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
  @@map("verification_tokens")
}

/// TOTP / backup codes for MFA (Better Auth twoFactor plugin). Secret is encrypted by Better Auth.
model TwoFactor {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  secret      String
  backupCodes String @map("backup_codes")
  verified    Boolean @default(true)
  /// Consecutive failed verifications (Better Auth account lockout).
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

enum RoleScope {
  platform
  business
  creator
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  scope       RoleScope
  description String?

  permissions     RolePermission[]
  userRoles       UserRole[]
  businessMembers BusinessMember[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Platform/creator-scope role assignment (business roles live on business_members). See D-015.
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ───────────────────────────── Tenants & profiles ─────────────────────────────

enum VerificationStatus {
  unverified
  pending
  verified
  suspended
  expired
}

model Business {
  id                 String             @id @default(uuid()) @db.Uuid
  ownerUserId        String             @map("owner_user_id") @db.Uuid
  legalName          String             @map("legal_name")
  displayName        String             @map("display_name")
  slug               String             @unique
  category           String
  description        String?
  country            String             @db.Char(2)
  city               String?
  timezone           String
  websiteUrl         String?            @map("website_url")
  logoFileId         String?            @map("logo_file_id") @db.Uuid
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  billingReady       Boolean            @default(false) @map("billing_ready")
  onboardingComplete Boolean            @default(false) @map("onboarding_complete")
  /// Hosts that referral destinations for this business may point to (spec §7.3).
  allowedDestinationHosts String[]      @default([]) @map("allowed_destination_hosts")
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner            User               @relation("BusinessOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members          BusinessMember[]
  catalogItems     CatalogItem[]
  campaigns        Campaign[]
  partnerships     Partnership[]
  invitations      CampaignInvitation[]
  promotionCodes   PromotionCode[]
  commissionRules  CommissionRule[]
  conversions      Conversion[]
  fundings         MerchantFunding[]
  integrations     Integration[]
  billingCustomers BillingCustomer[]

  @@index([ownerUserId])
  @@map("businesses")
}

enum MemberStatus {
  invited
  active
  revoked
}

model BusinessMember {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  roleId     String       @map("role_id") @db.Uuid
  status     MemberStatus @default(active)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

model Creator {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  handle             String             @unique
  displayName        String             @map("display_name")
  bio                String?
  avatarFileId       String?            @map("avatar_file_id") @db.Uuid
  country            String?            @db.Char(2)
  city               String?
  languages          String[]           @default([])
  categories         String[]           @default([])
  portfolioUrls      String[]           @default([]) @map("portfolio_urls")
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  onboardingComplete Boolean            @default(false) @map("onboarding_complete")
  /// Payout readiness (KYC is provider-side; this records readiness state only, spec §10.5).
  payoutReadiness    String             @default("not_ready") @map("payout_readiness")
  payoutMethod       Json?              @map("payout_method")
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  socialAccounts SocialAccount[]
  applications   CampaignApplication[]
  invitations    CampaignInvitation[]
  partnerships   Partnership[]
  promotionCodes PromotionCode[]
  payouts        Payout[]

  @@map("creators")
}

enum SocialConnectionStatus {
  not_connected
  connected
  error
  disconnected
}

enum MetricVerificationState {
  verified
  self_reported
}

/// Social account with metric provenance (spec §4.3: source, fetched_at, definition/version, verified vs self-reported).
model SocialAccount {
  id                    String                  @id @default(uuid()) @db.Uuid
  creatorId             String                  @map("creator_id") @db.Uuid
  platform              String
  platformAccountId     String?                 @map("platform_account_id")
  handle                String?
  profileUrl            String?                 @map("profile_url")
  connectionStatus      SocialConnectionStatus  @default(not_connected) @map("connection_status")
  verificationState     MetricVerificationState @default(self_reported) @map("verification_state")
  followerCount         BigInt?                 @map("follower_count")
  averageViews          BigInt?                 @map("average_views")
  engagementRate        Decimal?                @map("engagement_rate") @db.Decimal(9, 6)
  likesAvg              BigInt?                 @map("likes_avg")
  commentsAvg           BigInt?                 @map("comments_avg")
  audienceData          Json?                   @map("audience_data")
  sourcePlatformVersion String?                 @map("source_platform_version")
  metricDefinitionVersion String?               @map("metric_definition_version")
  fetchedAt             DateTime?               @map("fetched_at") @db.Timestamptz(6)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@unique([creatorId, platform])
  @@map("social_accounts")
}

// ───────────────────────────── Catalog & campaigns ─────────────────────────────

enum CatalogItemType {
  product
  service
  subscription
  other
}

model CatalogItem {
  id          String          @id @default(uuid()) @db.Uuid
  businessId  String          @map("business_id") @db.Uuid
  name        String
  slug        String
  type        CatalogItemType
  description String?
  category    String?
  priceMinor  BigInt?         @map("price_minor")
  currency    String?         @db.Char(3)
  externalRef String?         @map("external_ref")
  active      Boolean         @default(true)
  mediaIds    String[]        @default([]) @map("media_ids") @db.Uuid
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  campaigns Campaign[]

  @@unique([businessId, slug])
  @@index([businessId, active])
  @@map("catalog_items")
}

enum CampaignStatus {
  draft
  pending_review
  published
  active
  paused
  ended
  archived
}

enum CompensationType {
  commission_only
  gift_commission
  fixed_fee_commission
  paid_content
}

enum ConversionSourceType {
  webhook_api
  pos
  booking_api
  redemption_interface
  manual_evidence
  other
}

enum FulfillmentMode {
  online
  offline
  hybrid
}

model Campaign {
  id                       String               @id @default(uuid()) @db.Uuid
  businessId               String               @map("business_id") @db.Uuid
  catalogItemId            String               @map("catalog_item_id") @db.Uuid
  name                     String
  slug                     String
  description              String?
  imageFileId              String?              @map("image_file_id") @db.Uuid
  category                 String
  status                   CampaignStatus       @default(draft)
  startAt                  DateTime?            @map("start_at") @db.Timestamptz(6)
  endAt                    DateTime?            @map("end_at") @db.Timestamptz(6)
  timezone                 String
  creatorCapacity          Int?                 @map("creator_capacity")
  participantCap           Int?                 @map("participant_cap")
  applicationDeadlineAt    DateTime?            @map("application_deadline_at") @db.Timestamptz(6)
  waitlistEnabled          Boolean              @default(false) @map("waitlist_enabled")
  compensationType         CompensationType     @map("compensation_type")
  productServiceProvided   Boolean              @default(false) @map("product_service_provided")
  fixedFeeMinor            BigInt?              @map("fixed_fee_minor")
  destinationUrl           String?              @map("destination_url")
  conversionSourceType     ConversionSourceType @map("conversion_source_type")
  integrationId            String?              @map("integration_id") @db.Uuid
  fulfillmentMode          FulfillmentMode      @default(online) @map("fulfillment_mode")
  locationCountry          String?              @map("location_country") @db.Char(2)
  locationCity             String?              @map("location_city")
  platforms                String[]             @default([])
  currency                 String               @db.Char(3)
  customerDiscountConfig   Json                 @map("customer_discount_config")
  commissionRuleId         String?              @map("commission_rule_id") @db.Uuid
  attributionPolicy        Json                 @map("attribution_policy")
  attributionPolicyVersion String               @map("attribution_policy_version")
  holdPeriodDays           Int                  @map("hold_period_days")
  conversionApprovalMode   String               @default("auto_verified") @map("conversion_approval_mode")
  deliverableConfig        Json?                @map("deliverable_config")
  contentRightsConfig      Json?                @map("content_rights_config")
  promotionRules           Json?                @map("promotion_rules")
  cancellationRefundConfig Json?                @map("cancellation_refund_config")
  disclosureRequirements   Json?                @map("disclosure_requirements")
  legalDocumentVersion     String?              @map("legal_document_version")
  /// Monotonic version of the commercial configuration; partnerships snapshot a specific version.
  configVersion            Int                  @default(1) @map("config_version")
  version                  Int                  @default(1)
  publishedAt              DateTime?            @map("published_at") @db.Timestamptz(6)
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  business          Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  catalogItem       CatalogItem               @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  integration       Integration?              @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  commissionRule    CommissionRule?           @relation(fields: [commissionRuleId], references: [id], onDelete: Restrict)
  eligibilityRules  CampaignEligibilityRule[]
  applications      CampaignApplication[]
  invitations       CampaignInvitation[]
  partnerships      Partnership[]
  promotionCodes    PromotionCode[]

  @@unique([businessId, slug])
  @@index([status, category])
  @@index([businessId, status])
  @@map("campaigns")
}

model CampaignEligibilityRule {
  id         String  @id @default(uuid()) @db.Uuid
  campaignId String  @map("campaign_id") @db.Uuid
  ruleType   String  @map("rule_type")
  operator   String
  value      Json
  enabled    Boolean @default(true)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_eligibility_rules")
}

enum ApplicationStatus {
  pending
  waitlisted
  accepted
  rejected
  withdrawn
  expired
}

model CampaignApplication {
  id               String            @id @default(uuid()) @db.Uuid
  campaignId       String            @map("campaign_id") @db.Uuid
  creatorId        String            @map("creator_id") @db.Uuid
  status           ApplicationStatus @default(pending)
  message          String?
  submittedAt      DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt       DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy       String?           @map("reviewed_by") @db.Uuid
  rejectionReason  String?           @map("rejection_reason")
  waitlistPosition Int?              @map("waitlist_position")
  /// Campaign commercial config version the creator applied under; a later change requires re-confirmation.
  campaignConfigVersion Int          @default(1) @map("campaign_config_version")
  version          Int               @default(1)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  creator  Creator  @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@unique([campaignId, creatorId])
  @@index([campaignId, status])
  @@map("campaign_applications")
}

enum InvitationStatus {
  pending
  accepted
  declined
  revoked
  expired
}

/// Business-initiated invitations (D-014).
model CampaignInvitation {
  id                String           @id @default(uuid()) @db.Uuid
  campaignId        String           @map("campaign_id") @db.Uuid
  businessId        String           @map("business_id") @db.Uuid
  creatorId         String           @map("creator_id") @db.Uuid
  status            InvitationStatus @default(pending)
  message           String?
  proposedTermsJson Json?            @map("proposed_terms_json")
  invitedBy         String           @map("invited_by") @db.Uuid
  campaignConfigVersion Int          @default(1) @map("campaign_config_version")
  expiresAt         DateTime?        @map("expires_at") @db.Timestamptz(6)
  respondedAt       DateTime?        @map("responded_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  creator  Creator  @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@index([creatorId, status])
  @@index([campaignId])
  @@map("campaign_invitations")
}

// ───────────────────────────── Partnerships ─────────────────────────────

enum PartnershipStatus {
  pending
  active
  paused
  completed
  cancelled
  disputed
  terminated
}

model Partnership {
  id                       String            @id @default(uuid()) @db.Uuid
  businessId               String            @map("business_id") @db.Uuid
  creatorId                String            @map("creator_id") @db.Uuid
  campaignId               String            @map("campaign_id") @db.Uuid
  applicationId            String?           @unique @map("application_id") @db.Uuid
  invitationId             String?           @unique @map("invitation_id") @db.Uuid
  status                   PartnershipStatus @default(pending)
  acceptedAt               DateTime?         @map("accepted_at") @db.Timestamptz(6)
  endedAt                  DateTime?         @map("ended_at") @db.Timestamptz(6)
  termsSnapshotId          String?           @unique @map("terms_snapshot_id") @db.Uuid
  attributionPolicyVersion String            @map("attribution_policy_version")
  commissionRuleVersion    String            @map("commission_rule_version")
  legalDocumentVersion     String?           @map("legal_document_version")
  version                  Int               @default(1)
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  business       Business                    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  creator        Creator                     @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  campaign       Campaign                    @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  snapshots      PartnershipTermsSnapshot[]
  promotionCodes PromotionCode[]
  referralLinks  ReferralLink[]
  qrAssets       QrAsset[]
  deliverables   Deliverable[]
  contentRights  ContentRight[]
  conversation   Conversation?
  events         PartnershipEvent[]

  @@unique([campaignId, creatorId])
  @@index([businessId, status])
  @@index([creatorId, status])
  @@map("partnerships")
}

/// Frozen, immutable partnership terms (UPDATE/DELETE blocked by trigger).
model PartnershipTermsSnapshot {
  id                 String   @id @default(uuid()) @db.Uuid
  partnershipId      String   @map("partnership_id") @db.Uuid
  version            Int
  campaignConfigVersion Int   @map("campaign_config_version")
  termsJson          Json     @map("terms_json")
  commissionConfig   Json     @map("commission_config")
  discountConfig     Json     @map("discount_config")
  attributionPolicy  Json     @map("attribution_policy")
  deliverablesJson   Json?    @map("deliverables_json")
  contentRightsJson  Json?    @map("content_rights_json")
  promotionRulesJson Json?    @map("promotion_rules_json")
  payoutScheduleJson Json?    @map("payout_schedule_json")
  holdPeriodDays     Int      @map("hold_period_days")
  refundPolicyJson   Json?    @map("refund_policy_json")
  feePlanJson        Json     @map("fee_plan_json")
  acceptedBy         String   @map("accepted_by") @db.Uuid
  acceptedAt         DateTime @map("accepted_at") @db.Timestamptz(6)
  hash               String

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Restrict)

  @@unique([partnershipId, version])
  @@map("partnership_terms_snapshots")
}

/// Partnership activity timeline (spec §12.5).
model PartnershipEvent {
  id            String   @id @default(uuid()) @db.Uuid
  partnershipId String   @map("partnership_id") @db.Uuid
  eventType     String   @map("event_type")
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  data          Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Restrict)

  @@index([partnershipId, createdAt])
  @@map("partnership_events")
}

// ───────────────────────────── Promotion assets ─────────────────────────────

enum PromotionAssetStatus {
  pending
  active
  paused
  expired
  revoked
}

model PromotionCode {
  id               String               @id @default(uuid()) @db.Uuid
  businessId       String               @map("business_id") @db.Uuid
  campaignId       String               @map("campaign_id") @db.Uuid
  partnershipId    String               @map("partnership_id") @db.Uuid
  creatorId        String               @map("creator_id") @db.Uuid
  code             String
  normalizedCode   String               @map("normalized_code")
  status           PromotionAssetStatus @default(pending)
  startsAt         DateTime?            @map("starts_at") @db.Timestamptz(6)
  expiresAt        DateTime?            @map("expires_at") @db.Timestamptz(6)
  usageLimit       Int?                 @map("usage_limit")
  perCustomerLimit Int?                 @map("per_customer_limit")
  usageCount       Int                  @default(0) @map("usage_count")
  rulesJson        Json?                @map("rules_json")
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?              @map("revoke_reason")
  version          Int                  @default(1)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  business    Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  campaign    Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  partnership Partnership               @relation(fields: [partnershipId], references: [id], onDelete: Restrict)
  creator     Creator                   @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  redemptions PromotionCodeRedemption[]

  /// Scoped uniqueness: a normalized code is never reusable within a business, even after expiry/revoke (spec §7.1).
  @@unique([businessId, normalizedCode])
  @@index([partnershipId])
  @@map("promotion_codes")
}

/// Code usage ledger for usage/per-customer limits (one row per counted redemption).
model PromotionCodeRedemption {
  id              String   @id @default(uuid()) @db.Uuid
  promotionCodeId String   @map("promotion_code_id") @db.Uuid
  conversionId    String?  @unique @map("conversion_id") @db.Uuid
  customerRefHash String?  @map("customer_ref_hash")
  redeemedAt      DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)
  source          String

  promotionCode PromotionCode @relation(fields: [promotionCodeId], references: [id], onDelete: Restrict)

  @@index([promotionCodeId, customerRefHash])
  @@map("promotion_code_redemptions")
}

model ReferralLink {
  id             String               @id @default(uuid()) @db.Uuid
  partnershipId  String               @map("partnership_id") @db.Uuid
  token          String               @unique
  destinationUrl String               @map("destination_url")
  allowedHost    String               @map("allowed_host")
  status         PromotionAssetStatus @default(pending)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  partnership Partnership     @relation(fields: [partnershipId], references: [id], onDelete: Restrict)
  qrAssets    QrAsset[]
  clicks      TrackingClick[]

  @@index([partnershipId])
  @@map("referral_links")
}

enum QrStatus {
  active
  expired
  revoked
}

model QrAsset {
  id             String   @id @default(uuid()) @db.Uuid
  partnershipId  String   @map("partnership_id") @db.Uuid
  referralLinkId String?  @map("referral_link_id") @db.Uuid
  assetFileId    String   @map("asset_file_id") @db.Uuid
  encodedUrl     String   @map("encoded_url")
  status         QrStatus @default(active)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  partnership  Partnership   @relation(fields: [partnershipId], references: [id], onDelete: Restrict)
  referralLink ReferralLink? @relation(fields: [referralLinkId], references: [id], onDelete: Restrict)
  assetFile    File          @relation(fields: [assetFileId], references: [id], onDelete: Restrict)

  @@map("qr_assets")
}

// ───────────────────────────── Tracking & attribution ─────────────────────────────

model TrackingClick {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  campaignId     String?  @map("campaign_id") @db.Uuid
  partnershipId  String?  @map("partnership_id") @db.Uuid
  creatorId      String?  @map("creator_id") @db.Uuid
  referralLinkId String?  @map("referral_link_id") @db.Uuid
  trackingSessionId String? @map("tracking_session_id") @db.Uuid
  /// Opaque id propagated to the merchant as `codek_ref` for server-side attribution.
  clickRef       String   @unique @map("click_ref")
  method         String   @default("link")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  sessionKeyHash String?  @map("session_key_hash")
  source         String?
  landingUrl     String?  @map("landing_url")
  userAgentHash  String?  @map("user_agent_hash")
  ipHash         String?  @map("ip_hash")
  consentState   String?  @map("consent_state")
  suspected      Boolean  @default(false)

  referralLink ReferralLink? @relation(fields: [referralLinkId], references: [id], onDelete: Restrict)

  @@index([businessId, occurredAt])
  @@index([partnershipId, occurredAt])
  @@map("tracking_clicks")
}

model TrackingSession {
  id             String    @id @default(uuid()) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  campaignId     String?   @map("campaign_id") @db.Uuid
  partnershipId  String?   @map("partnership_id") @db.Uuid
  creatorId      String?   @map("creator_id") @db.Uuid
  sessionKeyHash String    @map("session_key_hash")
  firstTouchAt   DateTime? @map("first_touch_at") @db.Timestamptz(6)
  lastTouchAt    DateTime? @map("last_touch_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  consentState   String?   @map("consent_state")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([businessId, sessionKeyHash])
  @@map("tracking_sessions")
}

enum TouchpointMethod {
  code
  link
  qr
  other
}

model AttributionTouchpoint {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @map("business_id") @db.Uuid
  conversionId    String?          @map("conversion_id") @db.Uuid
  campaignId      String?          @map("campaign_id") @db.Uuid
  partnershipId   String?          @map("partnership_id") @db.Uuid
  creatorId       String?          @map("creator_id") @db.Uuid
  method          TouchpointMethod
  eventType       String           @map("event_type")
  externalEventId String?          @map("external_event_id")
  sourceRef       String?          @map("source_ref")
  occurredAt      DateTime         @map("occurred_at") @db.Timestamptz(6)
  eligible        Boolean          @default(true)
  ineligibleReason String?         @map("ineligible_reason")
  metadata        Json?
  dedupeKey       String?          @unique @map("dedupe_key")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  conversion Conversion? @relation(fields: [conversionId], references: [id], onDelete: Restrict)

  @@index([conversionId])
  @@index([businessId, occurredAt])
  @@map("attribution_touchpoints")
}

enum ConflictState {
  none
  conflict
  unresolved
}

enum DedupeState {
  unique
  duplicate
  suspect
}

enum DecisionState {
  attributed
  unattributed
  conflicted
  invalid
  duplicate
}

/// Immutable attribution decision (UPDATE/DELETE blocked). Re-decisions create a new row with `supersedes_id`.
model AttributionDecision {
  id                     String        @id @default(uuid()) @db.Uuid
  businessId             String        @map("business_id") @db.Uuid
  conversionId           String        @map("conversion_id") @db.Uuid
  selectedPartnershipId  String?       @map("selected_partnership_id") @db.Uuid
  selectedCreatorId      String?       @map("selected_creator_id") @db.Uuid
  selectedTouchpointId   String?       @map("selected_touchpoint_id") @db.Uuid
  method                 String
  policyId               String        @map("policy_id")
  policyVersion          String        @map("policy_version")
  model                  String
  windowSeconds          BigInt?       @map("window_seconds")
  competingTouchpoints   Json?         @map("competing_touchpoints")
  conflictState          ConflictState @map("conflict_state")
  dedupeState            DedupeState   @map("dedupe_state")
  decisionState          DecisionState @map("decision_state")
  reason                 String
  supersedesId           String?       @map("supersedes_id") @db.Uuid
  decidedBy              String?       @map("decided_by") @db.Uuid
  decidedAt              DateTime      @default(now()) @map("decided_at") @db.Timestamptz(6)

  conversion Conversion @relation("ConversionDecisions", fields: [conversionId], references: [id], onDelete: Restrict)

  @@index([conversionId])
  @@index([businessId, decisionState])
  @@map("attribution_decisions")
}

// ───────────────────────────── Conversions ─────────────────────────────

enum ConversionType {
  sale
  booking
  redemption
  lead
  registration
  other
}

enum ConversionStatus {
  received
  validated
  attributed
  approved
  rejected
  cancelled
  refunded
  partially_refunded
  reversed
}

enum VerifiedState {
  verified
  self_reported
  unknown
}

model Conversion {
  id                    String           @id @default(uuid()) @db.Uuid
  businessId            String           @map("business_id") @db.Uuid
  campaignId            String?          @map("campaign_id") @db.Uuid
  partnershipId         String?          @map("partnership_id") @db.Uuid
  creatorId             String?          @map("creator_id") @db.Uuid
  integrationId         String?          @map("integration_id") @db.Uuid
  type                  ConversionType
  status                ConversionStatus @default(received)
  externalRef           String           @map("external_ref")
  grossMinor            BigInt?          @map("gross_minor")
  discountMinor         BigInt?          @map("discount_minor")
  taxMinor              BigInt?          @map("tax_minor")
  shippingFeeMinor      BigInt?          @map("shipping_fee_minor")
  otherFeeMinor         BigInt?          @map("other_fee_minor")
  netMinor              BigInt?          @map("net_minor")
  commissionableMinor   BigInt?          @map("commissionable_minor")
  refundedMinor         BigInt           @default(0) @map("refunded_minor")
  currency              String?          @db.Char(3)
  lineItems             Json?            @map("line_items")
  verifiedState         VerifiedState    @map("verified_state")
  sourceSystem          String           @map("source_system")
  customerRefHash       String?          @map("customer_ref_hash")
  attributionDecisionId String?          @unique @map("attribution_decision_id") @db.Uuid
  reviewReason          String?          @map("review_reason")
  paidConfirmedAt       DateTime?        @map("paid_confirmed_at") @db.Timestamptz(6)
  occurredAt            DateTime         @map("occurred_at") @db.Timestamptz(6)
  version               Int              @default(1)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  business      Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  events        ConversionEvent[]
  touchpoints   AttributionTouchpoint[]
  decisions     AttributionDecision[]   @relation("ConversionDecisions")
  commission    CommissionCalculation?

  /// Deduplication: one conversion per external order/booking/redemption per business and source (spec §6.9).
  @@unique([businessId, sourceSystem, externalRef])
  @@index([businessId, occurredAt])
  @@index([partnershipId, status])
  @@index([creatorId, status])
  @@map("conversions")
}

enum ConversionEventState {
  received
  processed
  failed
  ignored
}

/// Event lineage: raw webhook → normalized event → conversion (spec §11.6).
model ConversionEvent {
  id              String               @id @default(uuid()) @db.Uuid
  conversionId    String?              @map("conversion_id") @db.Uuid
  webhookEventId  String?              @map("webhook_event_id") @db.Uuid
  businessId      String               @map("business_id") @db.Uuid
  eventType       String               @map("event_type")
  schemaVersion   String               @map("schema_version")
  source          String
  externalEventId String?              @map("external_event_id")
  occurredAt      DateTime             @map("occurred_at") @db.Timestamptz(6)
  receivedAt      DateTime             @default(now()) @map("received_at") @db.Timestamptz(6)
  payloadJson     Json                 @map("payload_json")
  processingState ConversionEventState @default(received) @map("processing_state")
  processingNote  String?              @map("processing_note")
  retryCount      Int                  @default(0) @map("retry_count")
  correlationId   String?              @map("correlation_id")

  conversion   Conversion?   @relation(fields: [conversionId], references: [id], onDelete: Restrict)
  webhookEvent WebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: Restrict)

  @@unique([businessId, source, externalEventId])
  @@index([conversionId])
  @@map("conversion_events")
}

// ───────────────────────────── Commission & ledger ─────────────────────────────

enum CommissionType {
  percentage
  fixed
  hybrid
}

enum CommissionBaseType {
  gross
  discounted
  net
  custom
}

enum RoundingMode {
  half_up
  half_even
  floor
  ceil
}

enum RefundBehavior {
  clawback
  reverse
  none
}

/// Versioned commission rules. Rows are never edited once referenced; edits create a new version.
model CommissionRule {
  id              String             @id @default(uuid()) @db.Uuid
  businessId      String             @map("business_id") @db.Uuid
  ruleKey         String             @map("rule_key")
  version         Int
  type            CommissionType
  rate            Decimal?           @db.Decimal(9, 6)
  fixedMinor      BigInt?            @map("fixed_minor")
  baseType        CommissionBaseType @map("base_type")
  includeTax      Boolean            @default(false) @map("include_tax")
  includeShipping Boolean            @default(false) @map("include_shipping")
  excludedItems   Json?              @map("excluded_items")
  minMinor        BigInt?            @map("min_minor")
  maxMinor        BigInt?            @map("max_minor")
  currency        String?            @db.Char(3)
  roundingMode    RoundingMode       @default(half_up) @map("rounding_mode")
  refundBehavior  RefundBehavior     @default(reverse) @map("refund_behavior")
  activeFrom      DateTime           @default(now()) @map("active_from") @db.Timestamptz(6)
  activeTo        DateTime?          @map("active_to") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  business     Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  campaigns    Campaign[]
  calculations CommissionCalculation[]

  @@unique([businessId, ruleKey, version])
  @@map("commission_rules")
}

enum CommissionStatus {
  pending
  approved
  funded
  available
  payout_requested
  processing
  paid
  reversed
  clawback
}

/// Commission result + frozen rule snapshot. Amount columns are immutable (trigger); adjustments are separate rows/entries.
model CommissionCalculation {
  id                    String           @id @default(uuid()) @db.Uuid
  conversionId          String           @unique @map("conversion_id") @db.Uuid
  businessId            String           @map("business_id") @db.Uuid
  creatorId             String           @map("creator_id") @db.Uuid
  partnershipId         String           @map("partnership_id") @db.Uuid
  termsSnapshotId       String           @map("terms_snapshot_id") @db.Uuid
  commissionRuleId      String           @map("commission_rule_id") @db.Uuid
  commissionRuleVersion Int              @map("commission_rule_version")
  ruleSnapshot          Json             @map("rule_snapshot")
  baseMinor             BigInt           @map("base_minor")
  rate                  Decimal?         @db.Decimal(9, 6)
  fixedMinor            BigInt?          @map("fixed_minor")
  commissionMinor       BigInt           @map("commission_minor")
  feeMinor              BigInt           @default(0) @map("fee_minor")
  feePlanSnapshot       Json             @map("fee_plan_snapshot")
  reversedMinor         BigInt           @default(0) @map("reversed_minor")
  feeReversedMinor      BigInt           @default(0) @map("fee_reversed_minor")
  clawbackMinor         BigInt           @default(0) @map("clawback_minor")
  currency              String           @db.Char(3)
  status                CommissionStatus @default(pending)
  trace                 Json?
  holdUntil             DateTime         @map("hold_until") @db.Timestamptz(6)
  calculatedAt          DateTime         @default(now()) @map("calculated_at") @db.Timestamptz(6)
  approvedAt            DateTime?        @map("approved_at") @db.Timestamptz(6)
  fundedAt              DateTime?        @map("funded_at") @db.Timestamptz(6)
  availableAt           DateTime?        @map("available_at") @db.Timestamptz(6)
  paidAt                DateTime?        @map("paid_at") @db.Timestamptz(6)
  onHold                Boolean          @default(false) @map("on_hold")
  holdReason            String?          @map("hold_reason")
  version               Int              @default(1)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversion     Conversion     @relation(fields: [conversionId], references: [id], onDelete: Restrict)
  commissionRule CommissionRule @relation(fields: [commissionRuleId], references: [id], onDelete: Restrict)
  payoutItems    PayoutItem[]

  @@index([creatorId, status])
  @@index([businessId, status])
  @@map("commission_calculations")
}

enum LedgerOwnerType {
  platform
  business
  creator
  provider
}

enum LedgerAccountStatus {
  active
  closed
}

model LedgerAccount {
  id          String              @id @default(uuid()) @db.Uuid
  businessId  String?             @map("business_id") @db.Uuid
  ownerType   LedgerOwnerType     @map("owner_type")
  ownerId     String?             @map("owner_id") @db.Uuid
  /// owner_id, or 'platform' for platform accounts — gives a NOT NULL uniqueness key.
  ownerKey    String              @map("owner_key")
  accountType String              @map("account_type")
  currency    String              @db.Char(3)
  status      LedgerAccountStatus @default(active)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  lines LedgerEntryLine[]

  @@unique([ownerType, ownerKey, accountType, currency])
  @@index([ownerType, ownerId])
  @@map("ledger_accounts")
}

/// Journal entry header. Immutable (trigger). Balanced per currency via deferred constraint trigger.
model LedgerEntry {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String?  @map("business_id") @db.Uuid
  entryType      String   @map("entry_type")
  referenceType  String?  @map("reference_type")
  referenceId    String?  @map("reference_id") @db.Uuid
  idempotencyKey String?  @unique @map("idempotency_key")
  currency       String   @db.Char(3)
  effectiveAt    DateTime @default(now()) @map("effective_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  description    String?
  metadata       Json?

  lines LedgerEntryLine[]

  @@index([referenceType, referenceId])
  @@index([businessId, effectiveAt])
  @@map("ledger_entries")
}

enum LedgerDirection {
  debit
  credit
}

model LedgerEntryLine {
  id              String          @id @default(uuid()) @db.Uuid
  ledgerEntryId   String          @map("ledger_entry_id") @db.Uuid
  ledgerAccountId String          @map("ledger_account_id") @db.Uuid
  direction       LedgerDirection
  amountMinor     BigInt          @map("amount_minor")
  currency        String          @db.Char(3)
  lineOrder       Int             @map("line_order")
  metadata        Json?

  entry   LedgerEntry   @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  account LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@unique([ledgerEntryId, lineOrder])
  @@index([ledgerAccountId])
  @@map("ledger_entry_lines")
}

// ───────────────────────────── Funding, payouts, providers ─────────────────────────────

enum FundingStatus {
  pending
  confirmed
  failed
  reversed
}

model MerchantFunding {
  id                    String        @id @default(uuid()) @db.Uuid
  businessId            String        @map("business_id") @db.Uuid
  amountMinor           BigInt        @map("amount_minor")
  currency              String        @db.Char(3)
  fundingMethod         String        @map("funding_method")
  providerReference     String?       @map("provider_reference")
  providerTransactionId String?       @map("provider_transaction_id") @db.Uuid
  status                FundingStatus @default(pending)
  idempotencyKey        String?       @unique @map("idempotency_key")
  requestedBy           String        @map("requested_by") @db.Uuid
  confirmedBy           String?       @map("confirmed_by") @db.Uuid
  failureReason         String?       @map("failure_reason")
  receivedAt            DateTime?     @map("received_at") @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  business            Business                    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  providerTransaction PaymentProviderTransaction? @relation("FundingProviderTx", fields: [providerTransactionId], references: [id], onDelete: Restrict)

  @@index([businessId, status])
  @@map("merchant_fundings")
}

enum PayoutStatus {
  available
  requested
  processing
  paid
  failed
  reversed
  cancelled
}

model Payout {
  id                    String       @id @default(uuid()) @db.Uuid
  creatorId             String       @map("creator_id") @db.Uuid
  businessId            String?      @map("business_id") @db.Uuid
  amountMinor           BigInt       @map("amount_minor")
  currency              String       @db.Char(3)
  status                PayoutStatus @default(requested)
  provider              String
  payoutMethodSnapshot  Json?        @map("payout_method_snapshot")
  idempotencyKey        String?      @unique @map("idempotency_key")
  requestedAt           DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  processedAt           DateTime?    @map("processed_at") @db.Timestamptz(6)
  providerTransactionId String?      @map("provider_transaction_id") @db.Uuid
  failureReasonCode     String?      @map("failure_reason_code")
  riskHold              Boolean      @default(false) @map("risk_hold")
  version               Int          @default(1)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator             Creator                     @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  attempts            PayoutAttempt[]
  items               PayoutItem[]
  providerTransaction PaymentProviderTransaction? @relation("PayoutProviderTx", fields: [providerTransactionId], references: [id], onDelete: Restrict)

  @@index([creatorId, status])
  @@map("payouts")
}

/// Which commissions a payout settles (D-016).
model PayoutItem {
  id                      String @id @default(uuid()) @db.Uuid
  payoutId                String @map("payout_id") @db.Uuid
  commissionCalculationId String @map("commission_calculation_id") @db.Uuid
  amountMinor             BigInt @map("amount_minor")

  payout     Payout                @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  commission CommissionCalculation @relation(fields: [commissionCalculationId], references: [id], onDelete: Restrict)

  @@unique([payoutId, commissionCalculationId])
  @@index([commissionCalculationId])
  @@map("payout_items")
}

enum PayoutAttemptStatus {
  pending
  processing
  success
  failed
}

/// Provider attempts are append-only history; failed attempts are never deleted (spec §10.5).
model PayoutAttempt {
  id                String              @id @default(uuid()) @db.Uuid
  payoutId          String              @map("payout_id") @db.Uuid
  attemptNumber     Int                 @map("attempt_number")
  provider          String
  providerReference String?             @map("provider_reference")
  status            PayoutAttemptStatus @default(pending)
  errorCode         String?             @map("error_code")
  errorMessageSafe  String?             @map("error_message_safe")
  startedAt         DateTime            @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime?           @map("finished_at") @db.Timestamptz(6)

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@unique([payoutId, attemptNumber])
  @@map("payout_attempts")
}

enum ProviderEnvironment {
  test
  live
}

model PaymentProviderTransaction {
  id                    String              @id @default(uuid()) @db.Uuid
  provider              String
  environment           ProviderEnvironment
  providerTransactionId String              @map("provider_transaction_id")
  transactionType       String              @map("transaction_type")
  status                String
  amountMinor           BigInt?             @map("amount_minor")
  currency              String?             @db.Char(3)
