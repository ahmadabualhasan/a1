}

model BillingSubscription {
  id                     String    @id @default(uuid()) @db.Uuid
  billingCustomerId      String    @map("billing_customer_id") @db.Uuid
  businessId             String    @map("business_id") @db.Uuid
  provider               String
  providerSubscriptionId String?   @map("provider_subscription_id")
  planKey                String    @map("plan_key")
  status                 String
  feePlanSnapshot        Json      @map("fee_plan_snapshot")
  periodStart            DateTime? @map("period_start") @db.Timestamptz(6)
  periodEnd              DateTime? @map("period_end") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer BillingCustomer @relation(fields: [billingCustomerId], references: [id], onDelete: Restrict)

  @@index([businessId, status])
  @@map("billing_subscriptions")
}

model BillingInvoice {
  id                String    @id @default(uuid()) @db.Uuid
  billingCustomerId String    @map("billing_customer_id") @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  provider          String
  providerInvoiceId String?   @map("provider_invoice_id")
  status            String
  amountMinor       BigInt    @map("amount_minor")
  currency          String    @db.Char(3)
  periodStart       DateTime? @map("period_start") @db.Timestamptz(6)
  periodEnd         DateTime? @map("period_end") @db.Timestamptz(6)
  lineItems         Json?     @map("line_items")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  customer BillingCustomer @relation(fields: [billingCustomerId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@map("billing_invoices")
}

enum LegalDocumentStatus {
  draft
  published
  retired
}

model LegalDocument {
  id           String              @id @default(uuid()) @db.Uuid
  documentType String              @map("document_type")
  version      String
  jurisdiction String?             @db.Char(2)
  title        String
  content      String
  contentHash  String              @map("content_hash")
  status       LegalDocumentStatus @default(draft)
  requiredFor  String[]            @default([]) @map("required_for")
  publishedAt  DateTime?           @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  acceptances LegalAcceptance[]

  @@unique([documentType, version, jurisdiction])
  @@map("legal_documents")
}

model LegalAcceptance {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  businessId      String?  @map("business_id") @db.Uuid
  creatorId       String?  @map("creator_id") @db.Uuid
  legalDocumentId String   @map("legal_document_id") @db.Uuid
  context         String?
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ipHash          String?  @map("ip_hash")
  userAgentHash   String?  @map("user_agent_hash")

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  legalDocument LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("legal_acceptances")
}

enum SettingEnvironment {
  dev
  staging
  production
}

model SystemSetting {
  id          String             @id @default(uuid()) @db.Uuid
  key         String             @unique
  kind        String             @default("setting")
  valueJson   Json               @map("value_json")
  environment SettingEnvironment @default(dev)
  enabled     Boolean            @default(true)
  description String?
  updatedBy   String?            @map("updated_by") @db.Uuid
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

enum DataRequestType {
  access
  deletion
  rectification
  portability
}

/// Data-subject request workflow (spec §14.1).
model DataSubjectRequest {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String?         @map("user_id") @db.Uuid
  requestType DataRequestType @map("request_type")
  status      String          @default("open")
  details     String?
  handledBy   String?         @map("handled_by") @db.Uuid
  resultNote  String?         @map("result_note")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime?       @map("completed_at") @db.Timestamptz(6)

  @@index([status])
  @@map("data_subject_requests")
}

/// Pre-aggregated daily analytics (background job); reconciles with ledger on money fields.
model AnalyticsDailyStat {
  id                  String   @id @default(uuid()) @db.Uuid
  day                 DateTime @db.Date
  /// Deterministic scope key: "<campaignId|*>:<partnershipId|*>:<currency|*>"
  scopeKey            String   @map("scope_key")
  businessId          String   @map("business_id") @db.Uuid
  campaignId          String?  @map("campaign_id") @db.Uuid
  partnershipId       String?  @map("partnership_id") @db.Uuid
  creatorId           String?  @map("creator_id") @db.Uuid
  currency            String?  @db.Char(3)
  clicks              Int      @default(0)
  qrScans             Int      @default(0) @map("qr_scans")
  trackedVisits       Int      @default(0) @map("tracked_visits")
  conversions         Int      @default(0)
  approvedConversions Int      @default(0) @map("approved_conversions")
  verifiedSalesMinor  BigInt   @default(0) @map("verified_sales_minor")
  commissionMinor     BigInt   @default(0) @map("commission_minor")
  feeMinor            BigInt   @default(0) @map("fee_minor")
  computedAt          DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@unique([day, businessId, scopeKey])
  @@index([businessId, day])
  @@map("analytics_daily_stats")
}
