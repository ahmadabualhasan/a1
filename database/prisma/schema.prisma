enum VerificationSubjectType {
  business
  creator
  user
}

enum VerificationCaseStatus {
  unverified
  pending
  verified
  suspended
  expired
  rejected
}

model VerificationCase {
  id             String                  @id @default(uuid()) @db.Uuid
  subjectType    VerificationSubjectType @map("subject_type")
  subjectId      String                  @map("subject_id") @db.Uuid
  status         VerificationCaseStatus  @default(pending)
  submittedBy    String?                 @map("submitted_by") @db.Uuid
  reviewerUserId String?                 @map("reviewer_user_id") @db.Uuid
  evidenceJson   Json?                   @map("evidence_json")
  reasonCode     String?                 @map("reason_code")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime?               @map("resolved_at") @db.Timestamptz(6)

  @@index([subjectType, subjectId])
  @@index([status])
  @@map("verification_cases")
}

enum Severity {
  low
  medium
  high
  critical
}

enum FraudFlagStatus {
  open
  reviewing
  resolved
  dismissed
}

model FraudFlag {
  id           String          @id @default(uuid()) @db.Uuid
  businessId   String?         @map("business_id") @db.Uuid
  subjectType  String          @map("subject_type")
  subjectId    String          @map("subject_id") @db.Uuid
  signalType   String          @map("signal_type")
  severity     Severity
  score        Decimal?        @db.Decimal(9, 4)
  evidenceJson Json?           @map("evidence_json")
  dedupeKey    String?         @unique @map("dedupe_key")
  status       FraudFlagStatus @default(open)
  fraudCaseId  String?         @map("fraud_case_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt   DateTime?       @map("resolved_at") @db.Timestamptz(6)

  fraudCase FraudCase? @relation(fields: [fraudCaseId], references: [id], onDelete: Restrict)

  @@index([status, severity])
  @@index([subjectType, subjectId])
  @@map("fraud_flags")
}

enum FraudCaseStatus {
  open
  evidence
  review
  decision
  closed
}

model FraudCase {
  id             String          @id @default(uuid()) @db.Uuid
  businessId     String?         @map("business_id") @db.Uuid
  subjectType    String          @map("subject_type")
