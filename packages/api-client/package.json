{
  "name": "@codek/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed CODEK API client generated from the OpenAPI contract (openapi-typescript + openapi-fetch).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "build": "echo \"source package (consumed via TypeScript paths by apps/web)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ignore-pattern src/schema.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@codek/eslint-config": "workspace:*",
    "@codek/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
