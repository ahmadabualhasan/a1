    "zod": "4.6.5"
  },
  "devDependencies": {
    "@codek/eslint-config": "workspace:*",
    "@codek/tsconfig": "workspace:*",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
