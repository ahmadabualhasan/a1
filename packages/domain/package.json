{
  "name": "@codek/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Pure CODEK domain logic: money, commission, attribution, ledger, state machines, permissions, event contracts.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
